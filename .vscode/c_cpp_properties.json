{
    "version": 4,
    "configurations": [
        {
            "name": "CMake Project",
            "compileCommands": "${workspaceFolder}/compile_commands.json",
            "intelliSenseMode": "linux-gcc-x86_64",
            "forcedInclude": [
                "${workspaceFolder}/include/vscode_fix.h"
            ],
            "includePath": [
                "${workspaceFolder}/include/**",
                "${workspaceFolder}/source/**",
                "${workspaceFolder}/libs/aegis_engine/include/**",
                "${workspaceFolder}/libs/aegis_engine/libs/**"
            ],
            "defines": [
                "ARM9",
                "__NDS__"
            ],
            "cStandard": "c11",
            "cppStandard": "c++17"
        }
    ]
}
