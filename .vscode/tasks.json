{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure (Host Debug)",
            "type": "shell",
            "command": "cmake --preset host-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure (NDS Release)",
            "type": "shell",
            "command": "cmake --preset nds-release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build (Host Tests)",
            "type": "shell",
            "command": "cmake --build --preset build-host-tests",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Build (Assets)",
            "type": "shell",
            "command": "cmake --build --preset build-assets",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Build (NDS SDCard)",
            "type": "shell",
            "command": "cmake --build --preset build-nds-sdcard",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Clean",
            "type": "shell",
            "command": "cmake --build --preset build-nds-sdcard --target clean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
