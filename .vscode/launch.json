{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "NDS ELF (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/nds-release/persona-3-dual.elf",
            "targetArchitecture": "arm",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "MIMode": "gdb",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "CMake: Build (NDS SDCard)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
